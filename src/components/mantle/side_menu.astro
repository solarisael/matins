---
import "../../styles/components/side_menu.css";
import "../../styles/components/portal_enchantment.css";
import {
  SITE_NAV_ITEMS,
  WRITING_PHASE_NAV_ITEMS,
} from "../../data/site_nav.js";
import RitualSeparator from "../ornament/ritual_separator.astro";
import Inscription from "../ornament/inscription.astro";
import ObsidianTablet from "../ornament/obsidian_tablet.astro";
import { with_base } from "../../utils/routes.js";

const menu_items = [
  ...SITE_NAV_ITEMS,
  ...WRITING_PHASE_NAV_ITEMS.filter((item) => item.phase === "codex"),
];

const site_theme_options = [
  {
    label: "solarisael",
    value: "solarisael",
  },
];

const site_fx_options = [
  {
    label: "subtle",
    value: "subtle",
  },
  {
    label: "balanced",
    value: "balanced",
  },
  {
    label: "bold",
    value: "bold",
  },
];

const site_shell_options = [
  {
    label: "subtle",
    value: "subtle",
  },
  {
    label: "medium",
    value: "medium",
  },
  {
    label: "strong",
    value: "strong",
  },
];

const site_scale_options = [
  {
    label: "100%",
    value: "100",
  },
  {
    label: "90%",
    value: "90",
  },
  {
    label: "80%",
    value: "80",
  },
];

const user_text_options = [
  {
    label: "compact",
    value: "compact",
  },
  {
    label: "normal",
    value: "normal",
  },
  {
    label: "large",
    value: "large",
  },
];

const user_measure_options = [
  {
    label: "focused",
    value: "focused",
  },
  {
    label: "comfort",
    value: "comfort",
  },
  {
    label: "wide",
    value: "wide",
  },
];
---

<mantle
  data-shape="side_menu"
  id="sol_side_menu"
  data-side-menu-open="false"
  data-side-menu-view="root"
>
  <button
    id="sol_side_menu_trigger"
    type="button"
    data-side-menu-trigger
    aria-controls="sol_side_menu_panel"
    aria-expanded="false"
    aria-label="Open Solarisael menu"
  >
    <span class="sol__side_menu_sun" aria-hidden="true"></span>
    <span class="sol__side_menu_trigger_label">menu</span>
  </button>

  <dialog
    id="sol_side_menu_panel"
    role="dialog"
    aria-label="Site navigation"
    aria-modal="true"
    data-side-menu-panel-shell
  >
    <canvas data-portal-ink aria-hidden="true"></canvas>

    <ObsidianTablet>
      <div slot="scene" data-portal-glyphs aria-hidden="true"></div>
      <div id="sol_side_menu_panel_scroll">
        <div id="sol_side_menu_panel_header">
          <button
            type="button"
            data-side-menu-close
            data-depth-region
            data-depth="12"
            data-depth-padding="18"
            data-depth-inner="0.25"
            aria-label="Close Solarisael menu"
          >
            <svg
              class="sol__close_rim"
              viewBox="0 0 44 44"
              fill="none"
              aria-hidden="true"
              focusable="false"
            >
              <circle
                cx="22"
                cy="22"
                r="21.5"
                fill="#0d111870"
                vector-effect="non-scaling-stroke"
                stroke="currentColor"
                stroke-width="0.5"></circle>
            </svg>
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="m6 6 12 12M18 6 6 18"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"></path>
            </svg>
          </button>
        </div>

        <div id="sol_side_menu_viewport">
          <section
            class="sol__side_menu_view"
            data-side-menu-view-page="root"
            data-view-position="active"
            aria-hidden="false"
          >
            <h2 class="sr-only">Site navigation</h2>
            <nav id="sol_side_menu_routes" aria-label="Site navigation">
              <ul
                class="sol__side_menu_route_list"
                data-depth-region
                data-depth-padding="36"
              >
                {
                  menu_items.map((nav_item) => (
                    <li>
                      <a
                        class="sol__side_menu_route"
                        data-side-menu-route
                        data-nav-label={nav_item.label}
                        data-phase={nav_item.phase}
                        href={with_base(nav_item.href)}
                        hx-get={with_base(nav_item.href)}
                      >
                        <Inscription text={nav_item.label} manual />
                      </a>
                    </li>
                  ))
                }
              </ul>

              <RitualSeparator />
            </nav>

            <div class="sol__side_menu_touch_status">
              <p
                id="sol_portal_touch_hint"
                data-portal-touch-hint
                role="status"
                aria-live="polite"
                hidden
              >
                tap again to enter
              </p>
            </div>

            <button
              class="sol__side_menu_state_link"
              type="button"
              data-side-menu-view-target="settings"
              data-side-menu-view-focus
              aria-controls="sol_side_menu_view_settings"
            >
              <span>
                <strong>site settings</strong>
              </span>
              <span aria-hidden="true">›</span>
            </button>
          </section>

          <section
            id="sol_side_menu_view_settings"
            class="sol__side_menu_view"
            data-side-menu-view-page="settings"
            data-view-position="after"
            aria-labelledby="sol_side_menu_settings_title"
            aria-hidden="true"
            inert
          >
            <div class="sol__side_menu_view_header">
              <button
                class="sol__side_menu_back"
                type="button"
                data-side-menu-view-target="root"
                data-side-menu-view-focus
                aria-controls="sol_side_menu_routes"
              >
                <span aria-hidden="true">‹</span>
                back
              </button>
              <div>
                <p class="sol__text_kicker">inner chamber</p>
                <h2 id="sol_side_menu_settings_title">Site settings</h2>
              </div>
            </div>

            <p class="sol__side_menu_note">
              Tune the shell without moving the page out from under your eyes.
            </p>

            <RitualSeparator />

            <div class="sol__side_menu_settings_section">
              <h3>Appearance</h3>
              <label class="sol__side_menu_group" for="sol_side_menu_theme">
                <span class="sol__side_menu_label sol__text_caption">theme</span
                >
                <select id="sol_side_menu_theme" data-site-theme-control>
                  {
                    site_theme_options.map((theme_option) => (
                      <option value={theme_option.value}>
                        {theme_option.label}
                      </option>
                    ))
                  }
                </select>
              </label>

              <label class="sol__side_menu_group" for="sol_side_menu_fx">
                <span class="sol__side_menu_label sol__text_caption">
                  intensity
                </span>
                <select id="sol_side_menu_fx" data-site-fx-control>
                  {
                    site_fx_options.map((fx_option) => (
                      <option value={fx_option.value}>{fx_option.label}</option>
                    ))
                  }
                </select>
              </label>

              <label class="sol__side_menu_group" for="sol_side_menu_shell">
                <span class="sol__side_menu_label sol__text_caption">shell</span
                >
                <select id="sol_side_menu_shell" data-site-shell-control>
                  {
                    site_shell_options.map((shell_option) => (
                      <option value={shell_option.value}>
                        {shell_option.label}
                      </option>
                    ))
                  }
                </select>
              </label>

              <label class="sol__side_menu_group" for="sol_side_menu_scale">
                <span class="sol__side_menu_label sol__text_caption">scale</span
                >
                <select id="sol_side_menu_scale" data-site-scale-control>
                  {
                    site_scale_options.map((scale_option) => (
                      <option value={scale_option.value}>
                        {scale_option.label}
                      </option>
                    ))
                  }
                </select>
              </label>
            </div>

            <RitualSeparator />

            <div class="sol__side_menu_settings_section">
              <h3>Reading</h3>
              <p class="sol__side_menu_note">
                Preferences that follow the reader, not the page.
              </p>

              <label class="sol__side_menu_group" for="sol_side_menu_text">
                <span class="sol__side_menu_label sol__text_caption">text</span>
                <select id="sol_side_menu_text" data-user-text-control>
                  {
                    user_text_options.map((text_option) => (
                      <option value={text_option.value}>
                        {text_option.label}
                      </option>
                    ))
                  }
                </select>
              </label>

              <label class="sol__side_menu_group" for="sol_side_menu_measure">
                <span class="sol__side_menu_label sol__text_caption"
                  >measure</span
                >
                <select id="sol_side_menu_measure" data-user-measure-control>
                  {
                    user_measure_options.map((measure_option) => (
                      <option value={measure_option.value}>
                        {measure_option.label}
                      </option>
                    ))
                  }
                </select>
              </label>
            </div>

            <RitualSeparator />

            <div class="sol__side_menu_settings_section">
              <h3>Local profile</h3>
              <p class="sol__side_menu_note">
                Browser-local only. No fake login, no pretend cloud account.
              </p>

              <dl class="sol__side_menu_status_list">
                <div>
                  <dt>profile</dt>
                  <dd>local visitor</dd>
                </div>
                <div>
                  <dt>storage</dt>
                  <dd>browser cookies</dd>
                </div>
              </dl>

              <button
                type="button"
                class="sol__side_menu_reset"
                data-side-menu-reset
              >
                reset local preferences
              </button>
            </div>
          </section>
        </div>
      </div>
    </ObsidianTablet>
  </dialog>
</mantle>

<script type="module" src={with_base("js/modules/side_menu_runtime.js")}
></script>

<script>
  import "../../scripts/portal_navigation.js";
</script>
